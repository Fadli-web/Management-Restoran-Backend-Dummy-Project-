        {
          "name": "Create Order - AUTO POTONG STOK (Kasir & Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.order && res.data.order.id) {",
                  "        pm.collectionVariables.set(\"order_id\", res.data.order.id);",
                  "        console.log(\"order_id berhasil disimpan:\", res.data.order.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"customer_name\": \"Budi Santoso\",\n    \"status\": \"pending\",\n    \"items\": [\n        {\n            \"menu_id\": \"{{menu_id}}\",\n            \"qty\": 2\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Membuat pesanan baru oleh Kasir/Admin.\nAlur Otomasi:\n1. Sistem memeriksa ketersediaan bahan resep menu di inventaris.\n2. Jika ada bahan tidak cukup -> request DITOLAK (HTTP 400).\n3. Jika semua bahan cukup -> stok inventaris LANGSUNG DIPOTONG otomatis dan pesanan tersimpan."
          },
          "response": []
        },
